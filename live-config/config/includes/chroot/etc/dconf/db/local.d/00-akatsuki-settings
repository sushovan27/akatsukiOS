# Akatsuki Linux GNOME Desktop Settings

[org/gnome/desktop/interface]
gtk-theme='Akatsuki-Dark'
icon-theme='Colloid-Dark'
cursor-theme='Bibata-Modern-Ice'
font-name='JetBrains Mono Regular 11'
document-font-name='JetBrains Mono Regular 11'
monospace-font-name='JetBrains Mono Regular 11'
color-scheme='prefer-dark'
enable-animations=true
clock-format='24h'
clock-show-weekday=true
show-battery-percentage=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='JetBrains Mono Bold 11'
theme='Akatsuki-Dark'
num-workspaces=5
workspace-names=['1: Dev', '2: Web', '3: Term', '4: Media', '5: Chat']

[org/gnome/desktop/wm/keybindings]
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
switch-to-workspace-5=['<Super>5']
move-to-workspace-1=['<Super><Shift>1']
move-to-workspace-2=['<Super><Shift>2']
move-to-workspace-3=['<Super><Shift>3']
move-to-workspace-4=['<Super><Shift>4']
move-to-workspace-5=['<Super><Shift>5']

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
two-finger-scrolling-enabled=true
natural-scroll=true

[org/gnome/desktop/peripherals/mouse]
natural-scroll=false
speed=0.0

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/akatsuki/desktop-wallpaper.jpg'
picture-uri-dark='file:///usr/share/backgrounds/akatsuki/desktop-wallpaper.jpg'
primary-color='#0f031a'
secondary-color='#1a0a2e'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/akatsuki/login-wallpaper.jpg'
primary-color='#0f031a'
secondary-color='#1a0a2e'
picture-options='zoom'
lock-delay=uint32 30

[org/gnome/desktop/session]
idle-delay=uint32 300

[org/gnome/desktop/privacy]
old-files-age=uint32 30
recent-files-max-age=30
remember-recent-files=true
remove-old-temp-files=true
remove-old-trash-files=true
report-technical-problems=false

[org/gnome/desktop/search-providers]
disabled=['org.gnome.Weather.desktop', 'org.gnome.Characters.desktop', 'org.gnome.Software.desktop']
sort-order=['org.gnome.Contacts.desktop', 'org.gnome.Documents.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Calculator.desktop']

[org/gnome/desktop/app-folders]
folder-children=['Utilities', 'Sundry', 'Development', 'Security', 'AI']

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'firefox-esr.desktop', 'kitty.desktop', 'code.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetext', 'just-perfection-desktop@just-perfection', 'caffeine@patapon.info', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'arc-menu@arc-menu.com', 'Vitals@CoreCoding.com']
disable-user-extensions=false
ubuntu-dock-hide=false

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
intellihide=false
dock-fixed=true
extend-height=false
height-fraction=0.9
dock-opacity=0.8
click-action='minimize-or-previews'
show-running=true
show-show-apps-at-top=true
isolate-workspaces=true
animate-show-apps=true
transparent=true
scroll-action='switch-workspace'
shift-click-action='minimize'
shift-middle-click-action='launch'
middle-click-action='quit'

[org/gnome/shell/extensions/blur-my-shell]
pipeline='pipeline_default'
blur-size=8
brightness=0.6
sigma=5
colorize=true
color='#0f031a'
noise-amount=0.1

[org/gnome/shell/extensions/just-perfection]
animation=2
clock-show-date=true
clock-show-seconds=false
search=false
theme=true
startup-status=0
window-demands-attention-focus=true
window-picker-icon=true
app-menu-icon=false
world-clock=true
weather=false

[org/gnome/shell/extensions/user-theme]
name='Akatsuki-Dark'

[org/gnome/shell/extensions/arc-menu]
menu-layout='ModernMenuLayout'
hot-corners=false
show-apps-icon='distributor-logo'
menu-button-icon='distributor-logo'
menu-button-radius=20
enable-animations=true

[org/gnome/shell/extensions/Vitals]
show-battery=true
show-cpu=true
show-memory=true
show-network=true
show-storage=true
hot-sensors=['_Processor', '_Memory', '_Network', '_Storage']

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c89796b3b2b5]
visible-name='Akatsuki'
use-theme-colors=false
background-color='#0f031a'
foreground-color='#d4bfff'
bold-color='#c792ea'
cursor-color='#7c4dff'
cursor-shape='block'
palette=['#0f031a', '#ff5370', '#c3e88d', '#ffcb6b', '#82aaff', '#c792ea', '#89ddff', '#eeffff', '#546e7a', '#ff5370', '#c3e88d', '#ffcb6b', '#82aaff', '#c792ea', '#89ddff', '#ffffff']
use-system-font=true
font='JetBrains Mono Regular 11'
scrollback-lines=10000
scroll-on-output=false
scroll-on-keystroke=true
audible-bell=false
visible-bell=true
bold-is-bright=true

[org/gnome/nautilus/preferences]
default-folder-viewer='list-view'
search-filter-time-type='last_modified'
recursive-search='always'
show-delete-permanently=true
show-hidden-files=true
show-image-thumbnails=true
thumbnail-limit=100

[org/gnome/nautilus/list-view]
default-visible-columns=['name', 'size', 'type', 'date_modified', 'date_created', 'starred', 'owner', 'group', 'permissions']
default-zoom-level='small'

[org/gnome/nautilus/icon-view]
default-zoom-level='standard'

[org/gnome/nautilus/compression]
default-compression-format='7z'

[org/gnome/nm-applet]
disable-connected-notifications=true
disable-disconnected-notifications=true

[org/gnome/software]
download-updates=true
download-updates-notify=true
first-run=false

[org/gnome/settings-daemon/plugins/power]
power-button-action='interactive'
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='suspend'
sleep-inactive-battery-timeout=1800
ambient-enabled=false
idle-dim=false

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
name='Terminal'
command='kitty'
binding='<Super>Return'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1]
name='File Manager'
command='nautilus --new-window'
binding='<Super>e'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2]
name='Screen Lock'
command='gnome-screensaver-command --lock'
binding='<Super>l'
