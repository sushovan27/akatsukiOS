#!/bin/bash
# Akatsuki Linux GRUB Configuration Hook
# Runs in the chroot before building the binary image

set -e

echo "Configuring GRUB for Akatsuki Linux..."

# Ensure GRUB theme directory exists
mkdir -p /usr/share/grub/themes/akatsuki

# Create GRUB font from JetBrains Mono if available
if command -v grub-mkfont &>/dev/null; then
    if [ -f /usr/share/fonts/truetype/jetbrains/JetBrainsMono-Bold.ttf ]; then
        mkdir -p /boot/grub/fonts
        grub-mkfont -s 18 -o /boot/grub/fonts/JetBrainsMonoBold18.pf2 \
            /usr/share/fonts/truetype/jetbrains/JetBrainsMono-Bold.ttf
    fi
fi

# Update GRUB configuration
if [ -f /etc/default/grub ]; then
    # Source our overrides
    if [ -d /etc/default/grub.d ]; then
        cp /etc/default/grub /etc/default/grub.backup
    fi
    update-grub 2>/dev/null || true
fi

echo "GRUB configuration complete."
